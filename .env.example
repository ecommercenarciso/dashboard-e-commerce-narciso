# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GA4_PROPERTY_ID: Your Google Analytics 4 Property ID
GA4_PROPERTY_ID="123456789"

# GOOGLE_APPLICATION_CREDENTIALS_JSON: The JSON content of your Google Cloud Service Account key
GOOGLE_APPLICATION_CREDENTIALS_JSON="{ \"type\": \"service_account\", ... }"

# VTEX_ACCOUNT_NAME: Your VTEX store account name
VTEX_ACCOUNT_NAME="youraccountname"

# VTEX_APP_KEY: Your VTEX Application Key
VTEX_APP_KEY="vtexappkey-..."

# VTEX_APP_TOKEN: Your VTEX Application Token
VTEX_APP_TOKEN="vtexapptoken-..."

